{
  // Cloudflare Workers 部署配置。不需要设置任何环境变量。
  "name": "canvasm",
  "main": "src/platforms/worker.mjs",
  "compatibility_date": "2026-01-01",
  // 静态页面（连接页、安全说明）直接由 Cloudflare 发；/api、/mcp、/healthz 走 Worker
  "assets": { "directory": "./public", "html_handling": "auto-trailing-slash" },
  // 保存加密后的连接记录。不写 id：第一次部署时 Cloudflare 会自动创建并绑定。
  // 删掉这一段就变成“无存储模式”（这时需要自己设置 GATEWAY_SECRET）。
  "kv_namespaces": [{ "binding": "TENANTS" }],
  // 不记录请求日志
  "observability": { "enabled": false }
}
